using Gtk 4.0;
using Adw 1;

template $GcalCalendarManagementDialog: Adw.Dialog {
  title: _("Calendar Settings");
  width-request: 360;
  height-request: 500;
  content-width: 500;

  Adw.NavigationView navigation_view {
    popped => $on_navigation_view_popped_cb(template) not-swapped;

    $GcalCalendarsPage {
      switch-page => $on_page_switched_cb(template) not-swapped;
    }

    $GcalEditCalendarPage {
      switch-page => $on_page_switched_cb(template) not-swapped;
    }

    $GcalNewLocalCalendarPage {
      switch-page => $on_page_switched_cb(template) not-swapped;
    }

    $GcalNewOnlineCalendarPage {
      switch-page => $on_page_switched_cb(template) not-swapped;
    }
  }
}
